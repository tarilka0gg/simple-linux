// ============================================================================
// NIRI CONFIGURATION 
// ============================================================================
// Minimal base config - customize to your needs
// Wiki: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
// ============================================================================

prefer-no-csd

// Noctalia-generated colors — included FIRST so manual overrides below win
// include "noctalia.kdl"  // вимкнено: Noctalia перегенеровує цей файл і перебиває futuro-darko кольори (focus-ring #ebdbb2)

hotkey-overlay {
    skip-at-startup
}

// Honor activation tokens even with invalid serials — lets apps like VS Code,
// Firefox, etc. steal focus when another app requests it (e.g. Nautilus open-with).
debug {
    honor-xdg-activation-with-invalid-serial
}


// ============================================================================
// INPUT
// ============================================================================

input {
    keyboard {
        xkb {
            layout "us,ua"
            options "grp:caps_toggle,lv3:ralt_switch"
        }
        repeat-delay 200
        repeat-rate 75
    track-layout "window"
}
    touchpad {
        tap
        tap-button-map "left-right-middle"
    }
    mouse {
        accel-profile "flat"
    }
    mod-key "Super"
    mod-key-nested "Alt"
    focus-follows-mouse max-scroll-amount="0%"
}

gestures {
    hot-corners {
        // off
    }
}

cursor {
    xcursor-size 24
    hide-when-typing
}

// ============================================================================
// LAYOUT
// ============================================================================

layout {
    gaps 10
   // background-color "transparent"
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    border {

        width 2
        active-color   "#98971a"
        inactive-color "#a89984"
        urgent-color   "#cc241d"
    }

    focus-ring {
       width 2
       active-color   "#98971a"
       inactive-color "#a89984"
   }

    shadow {
       // off
        softness 25
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts { }
    default-column-display "normal"
    }

overview {
    zoom 0.75

    // Solid backdrop between workspaces, matches gruvbox-material-light bg
    backdrop-color "#ebdbb2"

    // Uncomment to disable the workspace shadow in the overview.
    //workspace-shadow {
    //    off
    //}
}

// ============================================================================
// WINDOW RULES
// ============================================================================

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

// бордер у floating-вікон увімкнено (2026-07-24; раніше тут був off)
window-rule {
    match is-floating=true
    focus-ring { off; }
}


// Zen browser - усі вікна (включно з Private Browsing) завжди розгорнуті


// btop з wrapper скриптом що встановлює title

// Minecraft launcher

// Minecraft гра (Java)

// ============================================================================
// ENVIRONMENT
// ============================================================================

environment {
    XDG_CURRENT_DESKTOP "niri"
    QT_QPA_PLATFORM "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"

    QT_LOGGING_RULES "quickshell.dbus.properties=false"

    // Qt theming: switched from "kde" (reads dynamic Material-You colors from kdeglobals)
    // to qt6ct, so Qt apps use the static gruvbox-material palette instead.

    // Quickshell Python virtual environment

    // So $EDITOR is available to apps spawned directly by niri (e.g. yazi
    // via Super+E), which bypass fish's config.fish where this is also set.
}

// ============================================================================
// STARTUP
// ============================================================================

spawn-at-startup "xwayland-satellite"
spawn-at-startup "noctalia"



// На батареї sunshine не стартує, а панель іде на 60 Гц (див. battery-powersave-on.sh)


// Перенесено з runlevel default, щоб не затримувати завантаження:
// syncthing і sshd чекали на "net" і тягли за собою NetworkManager+dhcpcd.
// ============================================================================
// ANIMATIONS
// ============================================================================
// Tuned to complement quickshell's expressive Material motion curves
// QS uses ~500ms for main movements, ~400ms enter, ~200ms exit

animations {
    //off

    // Workspace switch: Match QS elementMove (~500ms, expressive overshoot)
    // damping-ratio < 1 = overshoot (like QS bezier [0.38, 1.21, 0.22, 1.00])
    workspace-switch {
        spring damping-ratio=0.78 stiffness=600 epsilon=0.0001
    }

    // Window open: Match QS elementMoveEnter (~400ms, emphasized decel)
    // Lower stiffness = slower start, smooth decel landing
    window-open {
        spring damping-ratio=0.82 stiffness=500 epsilon=0.0001
    }

    // Window close: Match QS elementMoveExit (~200ms, quick accel out)
    // Higher stiffness = snappier, quick exit
    window-close {
        spring damping-ratio=0.88 stiffness=900 epsilon=0.0001
    }

    // Horizontal view: Smooth panning with slight overshoot
    horizontal-view-movement {
        spring damping-ratio=0.80 stiffness=550 epsilon=0.0001
    }

    // Window movement: Interactive feel, responsive with gentle settle
    window-movement {
        spring damping-ratio=0.85 stiffness=650 epsilon=0.0001
    }

    // Column/window resize: Match QS elementResize (~300ms)
    window-resize {
        spring damping-ratio=0.88 stiffness=700 epsilon=0.0001
    }

    // Config notification: Quick feedback
    config-notification-open-close {
        spring damping-ratio=0.90 stiffness=800 epsilon=0.0001
    }

    // Screenshot UI: Snappy like QS fast effects
    screenshot-ui-open {
        spring damping-ratio=0.85 stiffness=750 epsilon=0.0001
  }
}

// ============================================================================
// KEYBINDINGS
// ============================================================================

binds {
    // System
    Mod+Tab repeat=false { toggle-overview; }
    Mod+Shift+E { quit; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Window Switcher (Alt+Tab) — Noctalia's own switcher
    Alt+Tab { spawn "noctalia" "msg" "window-switcher"; }
    Alt+Shift+Tab { spawn "noctalia" "msg" "window-switcher"; }  // TODO: перевірити чи є reverse-напрямок

    // Control Center
    Mod+Space repeat=false { spawn "noctalia" "msg" "panel-toggle" "control-center"; }

    // Clipboard
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    // Lock screen
    Mod+Alt+L allow-when-locked=true { spawn "noctalia" "msg" "session" "lock"; }

    // Screenshot
    Mod+Shift+S { spawn "noctalia" "msg" "screenshot-region"; }
    // Copies the path of the latest screenshot to the clipboard as text —
    // paste it (Ctrl+V) into Claude Code CLI instead of drag-and-drop,
    // since direct image-clipboard paste is broken upstream on Linux.
    // Mod+Shift+X (OCR) — немає прямого відповідника в noctalia, прибрано
    // Mod+Shift+A (visual search) — немає прямого відповідника в noctalia, прибрано

	//windows
	Mod+R { switch-preset-column-width; }  // Переключення між preset розмірами
	Mod+Equal { set-window-width "+10%"; }
	Mod+Minus { set-window-width "-10%"; }

    // Wallpaper selector
    Ctrl+Alt+T repeat=false { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }

    // Settings
    Mod+Comma { spawn "noctalia" "msg" "settings-toggle"; }

    // Neovim

    // Applications
    Mod+T { spawn "ghostty"; }
    Mod+Return { spawn "ghostty"; }
	Mod+S { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
	Mod+B { spawn "ghostty" "--title=btop-monitor" "-e" "btop"; }

    // Window management
    Mod+Q repeat=false { close-window; }
    Mod+D { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+A { toggle-window-floating; }

	Mod+Shift+O { power-off-monitors; }

    // Focus
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    // Move windows
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    // Screenshots (native niri)
    Print { screenshot; }
    Home { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // ========================================================================
    // HARDWARE KEYS - Audio, Brightness, Media (тепер напряму через noctalia IPC)
    // ========================================================================

    // Volume (hardware keys)
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    // Brightness (hardware keys)
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // Media playback (hardware keys)
    XF86AudioPlay { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPause { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioNext { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev { spawn "noctalia" "msg" "media" "previous"; }

    // Music control (keyboard alternatives)
    Ctrl+Mod+Space { spawn "noctalia" "msg" "media" "toggle"; }
    Mod+Alt+N { spawn "noctalia" "msg" "media" "next"; }
    Mod+Alt+P { spawn "noctalia" "msg" "media" "previous"; }
    Mod+Shift+M { spawn "noctalia" "msg" "volume-mute"; }
    Mod+Shift+P { spawn "noctalia" "msg" "media" "toggle"; }
    Mod+Shift+N { spawn "noctalia" "msg" "media" "next"; }
    Mod+Shift+B { spawn "noctalia" "msg" "media" "previous"; }

    // Power / Session — GUESS: немає єдиної команди "toggle power menu", біндю на logout-меню немає, тимчасово прибрано
    // Mod+Shift+Q { ??? }
}

// Layer rules for ii backdrop visibility during Niri overview
layer-rule {
    match namespace="quickshell:iiBackdrop"
    place-within-backdrop true
    opacity 1.0
}

layer-rule {
    match namespace="quickshell:wBackdrop"
    place-within-backdrop true
    opacity 1.0
}

// Outputs (example - disabled by default)
// Run `niri msg outputs` inside a niri session to see connector names and modes.
// Then edit and uncomment this block to pin a specific monitor layout.

output "BOE 0x09E5 Unknown" {
    mode "2560x1440@165.003"
    scale 1.25
    transform "normal"
    position x=0 y=0
}

output "Invalid Vendor Codename - RTK 0x0101 0x01010101" {
    mode "2560x1600@120.008"
    scale 1.25
    transform "270"
    position x=2048 y=-350
}



screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
